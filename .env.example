# Copy to `.env` for the two compose files. `.env` is gitignored; this file is not.
#
# Three values have no default and the compose files stop before creating a container without them:
# AUTH_PROVIDERS and BOOTSTRAP_ADMIN_PASSWORD (control plane) and GATEWAY_CP_URL (gateway).
# Everything else here is a default worth changing, with the reason it might need changing beside it.
#
# This file is a curated subset, not the contract. The compose files themselves name **every**
# variable each plane reads, grouped required and optional; `openspec/project.md` § Environment
# Variables is the table with the defaults in it.

# ---------------------------------------------------------------- which images
# The minor line, so patch releases arrive without an edit here. Pin an exact version — 1.2.4 — for
# a deployment you want to be able to reproduce.
APIM_VERSION=1.2

# ---------------------------------------------------------------- the first administrator
# Created once, and only while the local directory holds no account at all — so deleting this
# account and creating your own does not resurrect it at the next restart, and changing the
# username here does not create a second one.
#
# It is always created with "must change the password at first sign-in", because this value is in
# this file, in `docker inspect`, and in whatever shell wrote it. Twelve characters minimum; the
# control plane refuses to start with a shorter one rather than exempting the account that has
# every permission from the policy it enforces.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- the local sign-in policy
# Defaults, shown rather than set. Worth revisiting if `local` is there for break-glass
# administrators: the threshold is what stands between a mistyped sealed-envelope password and a
# 15-minute wait in the middle of an incident, and the rate limit is global across all callers
# rather than per address — it sits in front of the argon2 hash, so that a password sprayed across
# a thousand usernames cannot saturate the process without ever tripping a per-account counter.
#LOCAL_PASSWORD_MIN_LEN=12
#LOCAL_LOCKOUT_THRESHOLD=10
#LOCAL_LOCKOUT_MINUTES=15
#LOCAL_LOGIN_RATE_PER_MIN=60

# ---------------------------------------------------------------- addressing
# Where browsers reach the portal. It is the allowed `Origin` for every cookie-authenticated write
# (the CSRF check), and it is what an OIDC redirect URI's origin must equal.
PUBLIC_URL=http://localhost:8080

# The stages, in order. Promotion moves a definition one link along it and no further.
PROMOTION_CHAIN=dev,test,prod

# ---------------------------------------------------------------- sessions
# Idle and absolute, and they are distinct on purpose: the idle window slides on every request, so
# a working day is one sign-in; the absolute one does not, so a tab left open does not become a
# session that lives for ever.
SESSION_IDLE_MIN=60
SESSION_LIFETIME_HOURS=8

# How people sign in: an ordered subset of local,oidc,dev. Required, no default, and `dev` may not
# be combined with `oidc`. The order is the order the buttons appear in, first one focused.
#
# `oidc,local` is the combination most deployments want: single sign-on for people, plus a few
# local administrators for the day the provider is unreachable. Nothing about local sign-in touches
# the identity provider — discovery is fetched lazily rather than at boot, so the control plane
# starts while the provider is down, and the claims refresh runs only for sessions whose provider
# is `oidc`. A local administrator can therefore sign in and act with Keycloak entirely offline.
AUTH_PROVIDERS=local

# ---------------------------------------------------------------- the identity provider
# Set AUTH_PROVIDERS to `oidc,local` (or `oidc` alone) above and fill these in. There is nothing to
# uncomment in docker-compose.control-plane.yml — it passes all of these through already, and the
# control plane ignores every one of them until AUTH_PROVIDERS contains `oidc`.
#
# Left commented out here on purpose: an unset variable makes startup fail naming the variable,
# whereas a plausible-looking placeholder starts fine and fails at the first sign-in with a DNS
# error, which is a worse thing to debug.
#
# The first three are required together. The redirect URI is not derived from PUBLIC_URL because
# its origin must equal PUBLIC_URL's and startup refuses a mismatch — a derived value would follow
# a PUBLIC_URL edit past that check and fail later, at the provider's own registered-URI comparison.
#OIDC_ISSUER=https://keycloak.example.com/realms/portal
#OIDC_CLIENT_ID=integration-portal
#OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
# Absent means a public PKCE client, which is the Keycloak default for this shape.
#OIDC_CLIENT_SECRET=
#OIDC_DISPLAY_NAME=Company sign-in

# Which claim says what, as a dotted path. The defaults below are Keycloak's stock group mapper.
# Decode a real token from your realm before trusting them: point them at a path the realm does not
# use and everybody signs in fine, is in no application, and owns nothing — see README.md,
# "The two claims, and the three shapes they come in".
#OIDC_ROLE_CLAIM=realm_access.roles
#OIDC_ADMIN_ROLE=apim-admin
#OIDC_GROUP_CLAIM=groups

# For a realm that scopes roles per application — `"apps_with_role": {"podp.admin": ["PODP"]}` —
# the map's values are the applications and its keys are the roles, so it is named twice:
#OIDC_GROUP_CLAIM=apps_with_role
#OIDC_ROLE_CLAIM=roles
#OIDC_ADMIN_ROLE=PODP.ADMIN

# ---------------------------------------------------------------- subscription keys
# When the portal starts asking for a rotation, and when the key leaves the configuration document
# and the gateway refuses it. Both are shown on the subscription, so a consumer sees the date rather
# than being surprised by it.
#
# Raise the expiry before the **first** start against a database whose keys predate this setting: a
# key already older than it stops working at that start.
#SUBSCRIPTION_KEY_WARN_DAYS=365
#SUBSCRIPTION_KEY_EXPIRE_DAYS=600

# ---------------------------------------------------------------- the request logs
# `mock` generates deterministic simulated traffic from the published estate, and every screen that
# shows it says so. `elk` reads a real index. There is deliberately no fallback from `elk` to
# `mock`: a portal that quietly invented traffic while the cluster was down would present fiction as
# observation. With `elk`, ELK_URL is required, it must be in the egress allowlist, and either
# ELK_API_KEY or ELK_USERNAME with ELK_PASSWORD must be set.
LOGS_PROVIDER=mock
#ELK_URL=https://elk.example.com:9200
#ELK_API_KEY=
#ELK_INDEX=apim-access-*
#ELK_UPTIME_INDEX=heartbeat-*

# ---------------------------------------------------------------- the gateway
# Where this gateway polls. `http://control-plane:8080` is right only when both compose files are
# passed to one `docker compose`; on its own host it is the portal's real URL.
GATEWAY_CP_URL=http://control-plane:8080

# This instance's name, unique within its environment, and the token minted for it. A second
# gateway needs its own name, its own token file and its own published port.
DP_NAME=dev-1
DP_PORT=8081
GATEWAY_TOKEN_PATH=./.secrets/dev-1

# How often this gateway asks for configuration. The one cadence that is not a central setting: it
# is the channel every other setting arrives on, so a mistake in it slows down its own correction.
POLL_INTERVAL_SEC=5

# The request-body cap, the concurrency and buffer ceilings, the cache sizes, the JWKS refetch
# floor, the telemetry bounds and the access-log switches are the control plane's since v6. They
# are set on the portal's gateway settings screen — fleet-wide, per environment or per gateway —
# and travel in the configuration document, so a fleet has one value for each and it is visible in
# one place. Setting any of them here is a startup failure that names it.

# The reverse proxy's CIDRs, comma-separated. Empty means the gateway trusts nothing about
# `X-Forwarded-For` and uses the socket address — which is correct behind nothing, and wrong behind
# a load balancer, where every client IP it logs and rate-limits on would be the balancer's.
TRUSTED_PROXY_CIDRS=
