# Copy to `.env` for the two compose files. `.env` is gitignored; this file is not.
#
# Two values have no default and the compose files refuse to start without them:
# BOOTSTRAP_ADMIN_PASSWORD (control plane) and GATEWAY_CP_URL (gateway). Everything else here is a
# default worth changing, with the reason it might need changing beside it.

# ---------------------------------------------------------------- the first administrator
# Created once, and only while the local directory holds no account at all — so deleting this
# account and creating your own does not resurrect it at the next restart, and changing the
# username here does not create a second one.
#
# It is always created with "must change the password at first sign-in", because this value is in
# this file, in `docker inspect`, and in whatever shell wrote it. Twelve characters minimum; the
# control plane refuses to start with a shorter one rather than exempting the account that has
# every permission from the policy it enforces.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- addressing
# Where browsers reach the portal. It is the allowed `Origin` for every cookie-authenticated write
# (the CSRF check), and it is what an OIDC redirect URI's origin must equal.
PUBLIC_URL=http://localhost:8080

# The stages, in order. Promotion moves a definition one link along it and no further.
PROMOTION_CHAIN=dev,test,prod

# ---------------------------------------------------------------- sessions
# Idle and absolute, and they are distinct on purpose: the idle window slides on every request, so
# a working day is one sign-in; the absolute one does not, so a tab left open does not become a
# session that lives for ever.
SESSION_IDLE_MIN=60
SESSION_LIFETIME_HOURS=8

# How people sign in: an ordered subset of local,oidc,dev. Required, no default, and `dev` may not
# be combined with `oidc`.
AUTH_PROVIDERS=local

# ---------------------------------------------------------------- the identity provider
# Set AUTH_PROVIDERS to `local,oidc` (or `oidc` alone) above, fill these in, and uncomment the
# matching block in docker-compose.control-plane.yml. Leaving `local` on beside it keeps a way in
# when the provider is misconfigured, which is the situation in which you most need one.
#OIDC_ISSUER=https://keycloak.example.com/realms/portal
#OIDC_CLIENT_ID=integration-portal
#OIDC_CLIENT_SECRET=
#OIDC_ADMIN_ROLE=apim-admin
#OIDC_DISPLAY_NAME=Company sign-in

# ---------------------------------------------------------------- the gateway
# Where this gateway polls. `http://control-plane:8080` is right only when both compose files are
# passed to one `docker compose`; on its own host it is the portal's real URL.
GATEWAY_CP_URL=http://control-plane:8080

# This instance's name, unique within its environment, and the token minted for it. A second
# gateway needs its own name, its own token file and its own published port.
DP_NAME=dev-1
DP_PORT=8081
GATEWAY_TOKEN_PATH=./.secrets/dev-1

POLL_INTERVAL_SEC=5

# The largest request body any route on this gateway must accept, in bytes. 48 MiB by default.
MAX_BODY_BYTES=50331648

# The reverse proxy's CIDRs, comma-separated. Empty means the gateway trusts nothing about
# `X-Forwarded-For` and uses the socket address — which is correct behind nothing, and wrong behind
# a load balancer, where every client IP it logs and rate-limits on would be the balancer's.
TRUSTED_PROXY_CIDRS=
